# ==========================================
# NOIRÉ — Environment Variables Template
# ==========================================
# Copy to .env.local for local development.
# NEVER commit credentials or real secret keys to version control.

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL - Planned for backend phase)
DATABASE_URL="postgresql://user:password@localhost:5432/noire_store?schema=public"

# Authentication Secrets (Planned for Phase 5)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Payment Provider (To be configured based on merchant registration & supported currencies)
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

